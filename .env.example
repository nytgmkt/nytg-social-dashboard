# ─────────────────────────────────────────────────────────────────
# NYTG Social Media Dashboard — Environment Variables Reference
#
# This project does NOT use a .env file in its current form.
# All configuration is hardcoded in index.html (~line 724).
#
# This file is provided as a reference for anyone migrating
# to a build-based setup (Vite, webpack, etc.).
#
# To use: copy this file to .env and fill in real values.
# NEVER commit a .env file with real values to version control.
# ─────────────────────────────────────────────────────────────────

# ── Supabase ──────────────────────────────────────────────────────
# Project URL
# Where to find: Supabase Dashboard → Project Settings → API → Project URL
SUPABASE_URL=https://your-project-ref.supabase.co

# Anon / Public Key (safe to expose in browser)
# Where to find: Supabase Dashboard → Project Settings → API → anon public
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# Service Role Key — NEVER expose this in browser-side code
# Only needed for server-side admin scripts
# Where to find: Supabase Dashboard → Project Settings → API → service_role (secret)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key-here

# ── App Behaviour ──────────────────────────────────────────────────
# Sign-in timeout in milliseconds (default: 15000 = 15 seconds)
AUTH_TIMEOUT_MS=15000

# Rows per Supabase insert batch (default: 200)
SUPABASE_BATCH_SIZE=200

# ── Hosting ────────────────────────────────────────────────────────
# Public URL of the deployed app — used for Supabase auth redirects
# Must also be added to: Supabase Dashboard → Auth → URL Configuration
SITE_URL=https://your-org.github.io/nytg-social-dashboard/
